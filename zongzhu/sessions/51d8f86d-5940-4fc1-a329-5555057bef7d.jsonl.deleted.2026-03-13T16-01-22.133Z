est\": \"1.4.0\",\n        \"marketplace\": \"1.4.0\",\n        \"monetization\": \"1.4.0\",\n        \"payments\": \"1.4.0\",\n        \"solana\": \"1.4.0\",\n        \"stripe\": \"1.2.0\",\n        \"usdc\": \"1.4.0\",\n        \"web3\": \"1.4.0\",\n        \"x402\": \"1.4.0\",\n        \"x402 Bazaar\": \"1.2.0\",\n        \"x402 Protocol\": \"1.4.0\",\n        \"x402 Singularity Layer\": \"1.4.0\",\n        \"x402scan registration\": \"1.4.0\"\n      },\n      \"stats\": {\n        \"comments\": 0,\n        \"downloads\": 1863,\n        \"installsAllTime\": 4,\n        \"installsCurrent\": 2,\n        \"stars\": 2,\n        \"versions\": 13\n      },\n      \"createdAt\": 1770029396579,\n      \"updatedAt\": 1773330711580,\n      \"latestVersion\": {\n        \"version\": \"1.4.0\",\n        \"createdAt\": 1773328385635,\n        \"changelog\": \"x402-layer v1.4.0\\n=================\\n\\nRelease date: 2026-03-12\\nRelease type: minor\\n\\nSummary\\n-------\\nv1.4.0 turns ERC-8004 access into a wallet-first agentic lifecycle instead of a registration-only flow.\\nAgents can authenticate with their wallet, discover their owned agents and bindable endpoints, and manage existing registrations without relying on the dashboard UI.\\n\\nIncluded in v1.4.0\\n------------------\\n\\nWallet-first ERC-8004 lifecycle\\n- Defaulted `register_agent.py` to wallet-first ERC-8004 / Solana-8004 registration.\\n- Added wallet challenge + verify session flow support for agent-side auth.\\n- Removed the old x402-paid registration path and its `--legacy` / `X402_ERC8004_LEGACY=1` fallback.\\n\\nFull metadata parity\\n- Registration and update flows support:\\n  - `image`\\n  - `version`\\n  - `tags`\\n  - `endpointIds`\\n  - `customEndpoints`\\n- Worker validates that linked platform endpoints are actually owned by the authenticated wallet context.\\n\\nAgent discovery and management\\n- Added wallet-authenticated discovery routes:\\n  - `GET /agent/erc8004/mine`\\n  - `GET /agent/erc8004/endpoints/mine`\\n- Added skill scripts:\\n  - `list_agents.py`\\n  - `list_my_endpoints.py`\\n  - `update_agent.py`\\n- Added shared helper:\\n  - `erc8004_wallet_client.py`\\n\\nSolana hardening\\n- `SOLANA_SECRET_KEY` now works as either a base58 secret string or JSON byte array.\\n- Removed Solana script dependence on EVM-only `web3` imports during Solana execution.\\n- Replaced edge-incompatible `8004-solana` Pinata uploads in the worker with the worker-native Pinata uploader.\\n- Added structured error responses for Solana prepare/update prepare failures instead of raw Cloudflare `1101` pages.\\n- Fixed Solana endpoint ownership discovery for `chain=both` endpoints by checking `payment_options`.\\n- Switched Solana mainnet worker RPC to `https://solana-rpc.publicnode.com`.\\n\\nExpanded EVM exposure\\n- Kept wallet-first EVM support for:\\n  - Base\\n  - Ethereum\\n  - Polygon\\n  - BSC\\n  - Monad\\n- Updated skill/docs to present Ethereum, Polygon, BSC, and Monad as first-class `--network` targets for agentic ERC-8004 flows.\\n\\nDocs and distribution sync\\n- Synced source skill, worker embedded skill, ClawHub copy, docs-repo copy, and SGL docs copy.\\n- Updated human docs to reflect the wallet-first lifecycle and expanded network guidance.\\n- Removed legacy registration/update route guidance from the skill and public docs.\\n\\nLegacy removal\\n- Disabled `POST /agent/erc8004/register`.\\n- Disabled `PATCH /agent/erc8004/:agentId`.\\n- Removed `WORKER_REGISTRATION_API_KEY` usage from worker auth/feedback guidance and Solana registration fallback paths.\\n- Kept dashboard Solana registration non-custodial by limiting `/api/agents/solana/register` to `action=\\\"prepare\\\"` only.\\n\\nLive validation completed\\n-------------------------\\n\\nBase\\n- wallet auth challenge + verify\\n- wallet-first prepare\\n- Base Sepolia `register()`\\n- finalize after register\\n- `setAgentURI()`\\n- finalize after set-uri\\n- post-registration update prepare/finalize\\n- owned-agent discovery\\n- owned-endpoint discovery\\n\\nSolana mainnet\\n- owned-agent discovery\\n- owned-endpoint discovery\\n- full wallet-first update prepare\\n- full on-chain URI update and finalize on existing agent\\n- persisted readback of version, tags, and endpoint binding\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": [\n          \"linux\",\n          \"darwin\"\n        ],\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"agentic-spicy-food\",\n      \"displayName\": \"Agentic Spicy Food (Lafeitu)\",\n      \"summary\": \"The premier Agent-ready food delivery skill. Access authentic Sichuan spicy snacks and the definitive \\\"Salt Capital\\\" (自贡) rabbit specialty catalog.\",\n      \"tags\": {\n        \"latest\": \"1.8.4\"\n      },\n      \"stats\": {\n        \"comments\": 0,\n        \"downloads\": 1987,\n        \"installsAllTime\": 4,\n        \"installsCurrent\": 4,\n        \"stars\": 1,\n        \"versions\": 31\n      },\n      \"createdAt\": 1769426965008,\n      \"updatedAt\": 1773330709626,\n      \"latestVersion\": {\n        \"version\": \"1.8.4\",\n        \"createdAt\": 1773330475134,\n        \"changelog\": \"更新技能代码，优化辣匪兔外卖体验\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"nara\",\n      \"displayName\": \"Nara\",\n      \"summary\": \"Nara chain CLI agent — free PoMI mining, wallet, transfer, quest, on-chain skills, ZK ID, agent registry. Triggers: NARA, quest, mining, airdrop, earn/claim/...\",\n      \"tags\": {\n        \"latest\": \"1.0.5\"\n      },\n      \"stats\": {\n        \"comments\": 0,\n        \"downloads\": 81,\n        \"installsAllTime\": 0,\n        \"installsCurrent\": 0,\n        \"stars\": 0,\n        \"versions\": 6\n      },\n      \"createdAt\": 1773215294967,\n      \"updatedAt\": 1773330708574,\n      \"latestVersion\": {\n        \"version\": \"1.0.5\",\n        \"createdAt\": 1773325301914,\n        \"changelog\": \"- Added a new \\\"Agent Autonomy Rules\\\" section: clearly lists which Nara CLI operations require explicit user confirmation before execution.\\n- Specifies actions that are always safe to run without confirmation versus those requiring explicit consent (e.g., wallet creation, transfers, file uploads, endpoint changes).\\n- No changes to CLI commands or usage flow; documentation only.\\n- Improves safety and transparency for users interacting with Nara via agents or automated workflows.\",\n        \"license\": null\n      },\n      \"metadata\": null\n    }\n  ],\n  \"nextCursor\": \"07daa8bdf0af75921191f14e729cef81f5e9168fe81c02f4babeb0b79efb2dd58b11a12ebdb035ad4032a03e738be04d2f5fd5184b56d2b2ce330a1535c9fec8595040931bd638edc5cbbe0a4671077f09f450a4ee27405a29806731ce314956b20177d9e3b85558acdb873f733a8a55aec0655ec06c8ea2a14e6b19\"\n}"}],"details":{"status":"completed","exitCode":0,"durationMs":3290,"aggregated":"{\n  \"items\": [\n    {\n      \"slug\": \"writing-style-learner\",\n      \"displayName\": \"Style Learner\",\n      \"summary\": \"Extract and save writing style patterns from technical documents to build personalized or team writing guides with structured, reusable style records.\",\n      \"tags\": {\n        \"latest\": \"1.0.1\"\n      },\n      \"stats\": {\n        \"comments\": 0,\n        \"downloads\": 0,\n        \"installsAllTime\": 0,\n        \"installsCurrent\": 0,\n        \"stars\": 0,\n        \"versions\": 2\n      },\n      \"createdAt\": 1773327348797,\n      \"updatedAt\": 1773331312657,\n      \"latestVersion\": {\n        \"version\": \"1.0.1\",\n        \"createdAt\": 1773327534479,\n        \"changelog\": \"- Updated usage examples to reflect a new author name (\\\"Oldtimer\\\" instead of \\\"Zhang Haoyu\\\").\\n- No functional or feature changes.\",\n        \"license\": null\n      },\n      \"metadata\": null\n    },\n    {\n      \"slug\": \"jie