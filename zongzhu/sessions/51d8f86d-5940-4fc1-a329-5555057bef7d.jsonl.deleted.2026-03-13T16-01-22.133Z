{"type":"message","id":"d7476f3a","parentId":"2442f01c","timestamp":"2026-03-12T16:01:52.451Z","message":{"role":"toolResult","toolCallId":"call_7617c300204d428195fcf26e","toolName":"exec","content":[{"type":"text","text":"Usage: clawhub explore [options]\n\nBrowse latest updated skills from the registry\n\nOptions:\n  --limit <n>     Number of skills to show (max 200) (default: 25)\n  --sort <order>  Sort by newest, downloads, rating, installs, installsAllTime,\n                  or trending (default: \"newest\")\n  --json          Output JSON\n  -h, --help      display help for command"}],"details":{"status":"completed","exitCode":0,"durationMs":263,"aggregated":"Usage: clawhub explore [options]\n\nBrowse latest updated skills from the registry\n\nOptions:\n  --limit <n>     Number of skills to show (max 200) (default: 25)\n  --sort <order>  Sort by newest, downloads, rating, installs, installsAllTime,\n                  or trending (default: \"newest\")\n  --json          Output JSON\n  -h, --help      display help for command","cwd":"/Users/ciss-ai/.openclaw/agents/zongzhu"},"isError":false,"timestamp":1773331312450}}
