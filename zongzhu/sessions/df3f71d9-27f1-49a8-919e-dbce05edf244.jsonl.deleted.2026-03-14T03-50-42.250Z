        \"downloads\": 44279,\n        \"installsAllTime\": 547,\n        \"installsCurrent\": 535,\n        \"stars\": 239,\n        \"versions\": 3\n      },\n      \"createdAt\": 1770221093765,\n      \"updatedAt\": 1772063741465,\n      \"latestVersion\": {\n        \"version\": \"2.0.1\",\n        \"createdAt\": 1770313848158,\n        \"changelog\": \"**Multi-search-engine v2.0.1 Changelog**\\n\\n- Updated documentation for conciseness, focusing on essential usage, supported engines, operators, and example queries.\\n- Removed the file `references/advanced-search.md` to streamline advanced search documentation.\\n- Revised and unified description to highlight 17 search engines, advanced operators, privacy-focused engines, and knowledge computation.\\n- Cleaned up and reorganized SKILL.md; made operator and time filter tables clearer for easier reference.\\n- Updated metadata in config and documentation files for accuracy and clarity.\",\n        \"license\": null\n      },\n      \"metadata\": null\n    },\n    {\n      \"slug\": \"openai-whisper\",\n      \"displayName\": \"Openai Whisper\",\n      \"summary\": \"Local speech-to-text with the Whisper CLI (no API key).\",\n      \"tags\": {\n        \"latest\": \"1.0.0\"\n      },\n      \"stats\": {\n        \"comments\": 2,\n        \"downloads\": 42803,\n        \"installsAllTime\": 1209,\n        \"installsCurrent\": 1184,\n        \"stars\": 198,\n        \"versions\": 1\n      },\n      \"createdAt\": 1767545365755,\n      \"updatedAt\": 1772065840450,\n      \"latestVersion\": {\n        \"version\": \"1.0.0\",\n        \"createdAt\": 1767545365755,\n        \"changelog\": \"\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"api-gateway\",\n      \"displayName\": \"API Gateway\",\n      \"summary\": \"Connect to 100+ APIs (Google Workspace, Microsoft 365, GitHub, Notion, Slack, Airtable, HubSpot, etc.) with managed OAuth. Use this skill when users want to...\",\n      \"tags\": {\n        \"latest\": \"1.0.67\"\n      },\n      \"stats\": {\n        \"comments\": 2,\n        \"downloads\": 41274,\n        \"installsAllTime\": 231,\n        \"installsCurrent\": 223,\n        \"stars\": 207,\n        \"versions\": 68\n      },\n      \"createdAt\": 1769935067126,\n      \"updatedAt\": 1773314215262,\n      \"latestVersion\": {\n        \"version\": \"1.0.67\",\n        \"createdAt\": 1773313606464,\n        \"changelog\": \"- Added references/one-note/README.md file.\\n- No changes to existing functionality; update consists of new documentation or reference material.\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"auto-updater\",\n      \"displayName\": \"Auto-Updater Skill\",\n      \"summary\": \"Automatically update Clawdbot and all installed skills once daily. Runs via cron, checks for updates, applies them, and messages the user with a summary of what changed.\",\n      \"tags\": {\n        \"latest\": \"1.0.0\"\n      },\n      \"stats\": {\n        \"comments\": 5,\n        \"downloads\": 40640,\n        \"installsAllTime\": 653,\n        \"installsCurrent\": 627,\n        \"stars\": 254,\n        \"versions\": 1\n      },\n      \"createdAt\": 1768323539453,\n      \"updatedAt\": 1772074932947,\n      \"latestVersion\": {\n        \"version\": \"1.0.0\",\n        \"createdAt\": 1768323539453,\n        \"changelog\": \"Automatically checks for and applies updates to Clawdbot and all installed skills once daily via cron.\\n\\nSends the user a message summarizing what was updated and any issues encountered.\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": [\n          \"darwin\",\n          \"linux\"\n        ],\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"skill-creator\",\n      \"displayName\": \"Skill Creator\",\n      \"summary\": \"Guide for creating effective skills. This skill should be used when users want to create a new skill (or update an existing skill) that extends Claude's capabilities with specialized knowledge, workflows, or tool integrations.\",\n      \"tags\": {\n        \"latest\": \"0.1.0\"\n      },\n      \"stats\": {\n        \"comments\": 3,\n        \"downloads\": 37378,\n        \"installsAllTime\": 1235,\n        \"installsCurrent\": 1214,\n        \"stars\": 127,\n        \"versions\": 1\n      },\n      \"createdAt\": 1769522677376,\n      \"updatedAt\": 1773371296855,\n      \"latestVersion\": {\n        \"version\": \"0.1.0\",\n        \"createdAt\": 1769522677376,\n        \"changelog\": \"Initial release of skill-creator, a comprehensive guide for designing modular skills to extend Claude’s capabilities.\\n\\n- Introduces principles for creating effective, concise, and domain-specific skills.\\n- Explains modular structure: required SKILL.md and optional scripts, references, and assets folders.\\n- Outlines guidelines for what to include (and exclude) in a skill package.\\n- Details progressive disclosure design for efficient context management.\\n- Provides reference patterns for organizing content and bundling resources.\",\n        \"license\": null\n      },\n      \"metadata\": null\n    },\n    {\n      \"slug\": \"brave-search\",\n      \"displayName\": \"Brave Search\",\n      \"summary\": \"Web search and content extraction via Brave Search API. Use for searching documentation, facts, or any web content. Lightweight, no browser required.\",\n      \"tags\": {\n        \"latest\": \"1.0.1\"\n      },\n      \"stats\": {\n        \"comments\": 5,\n        \"downloads\": 37317,\n        \"installsAllTime\": 496,\n        \"installsCurrent\": 472,\n        \"stars\": 143,\n        \"versions\": 2\n      },\n      \"createdAt\": 1767545304976,\n      \"updatedAt\": 1773128298472,\n      \"latestVersion\": {\n        \"version\": \"1.0.1\",\n        \"createdAt\": 1767651953714,\n        \"changelog\": \"\",\n        \"license\": null\n      },\n      \"metadata\": null\n    },\n    {\n      \"slug\": \"automation-workflows\",\n      \"displayName\": \"Automation Workflows\",\n      \"summary\": \"Design and implement automation workflows to save time and scale operations as a solopreneur. Use when identifying repetitive tasks to automate, building workflows across tools, setting up triggers and actions, or optimizing existing automations. Covers automation opportunity identification, workflow design, tool selection (Zapier, Make, n8n), testing, and maintenance. Trigger on \\\"automate\\\", \\\"automation\\\", \\\"workflow automation\\\", \\\"save time\\\", \\\"reduce manual work\\\", \\\"automate my business\\\", \\\"no-code automation\\\".\",\n      \"tags\": {\n        \"latest\": \"0.1.0\"\n      },\n      \"stats\": {\n        \"comments\": 1,\n        \"downloads\": 36125,\n        \"installsAllTime\": 453,\n        \"installsCurrent\": 440,\n        \"stars\": 160,\n        \"versions\": 1\n      },\n      \"createdAt\": 1770341582349,\n      \"updatedAt\": 1772065840450,\n      \"latestVersion\": {\n        \"version\": \"0.1.0\",\n        \"createdAt\": 1770341582349,\n        \"changelog\": \"automation-workflows 0.1.0 initial release:\\n\\n- Launches comprehensive playbook for solopreneurs to design and implement no-code automation workflows.\\n- Covers identifying automation opportunities, workflow design principles, tool selection (Zapier, Make, n8n), and best practices for testing.\\n- Includes maintenance and troubleshooting guidance to ensure reliability.\\n- Provides ready-made workflow templates and advanced automation ideas.\\n- Triggers include common phrases like \\\"automation,\\\" \\\"workflows,\\\" \\\"save time,\\\" and \\\"no-code automation.\\\"\",\n        \"license\": null\n      },\n      \"metadata\": null\n    },\n    {\n      \"slug\": \"baidu-search\",\n      \"displayName\": \"baidu web search\",\n      \"summary\": \"Search the web using Baidu AI Search Engine (BDSE). Use for live information, documentation, or research topics.\",\n      \"tags\": {\n        \"latest\": \"1.1.1\"\n      },\n      \"stats\": {\n        \"comments\": 18,\n        \"downloads\": 35914,\n        \"installsAllTime\": 318,\n        \"installsCurrent\": 308,\n        \"stars\": 82,\n        \"versions\": 9\n      },\n      \"createdAt\": 1770291754419,\n      \"updatedAt\": 1773287521996,\n      \"latestVersion\": {\n        \"version\": \"1.1.1\",\n        \"createdAt\": 1773127227674,\n        \"changelog\": \"- Updated request parameters: simplified to include only query, count, and freshness.\\n- Added support for new freshness formats (\\\"YYYY-MM-DDtoYYYY-MM-DD\\\" and short codes pd/pw/pm/py).\\n- Default and range for count parameter clarified (default 10, range 1–50).\\n- Examples and usage instructions revised for new parameter set.\\n- Removed advanced resource and search filter options from documentation for simplicity.\\n- _meta.json file removed.\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"mcporter\",\n      \"displayName\": \"Mcporter\",\n      \"summary\": \"Use the mcporter CLI to list, configure, auth, and call MCP servers/tools directly (HTTP or stdio), including ad-hoc servers, config edits, and CLI/type generation.\",\n      \"tags\": {\n        \"latest\": \"1.0.0\"\n      },\n      \"stats\": {\n        \"comments\": 1,\n        \"downloads\": 35019,\n        \"installsAllTime\": 1199,\n        \"installsCurrent\": 1178,\n        \"stars\": 103,\n        \"versions\": 1\n      },\n      \"createdAt\": 1767545355897,\n      \"updatedAt\": 1773370819526,\n      \"latestVersion\": {\n        \"version\": \"1.0.0\",\n        \"createdAt\": 1767545355897,\n        \"changelog\": \"\",\n        \"license