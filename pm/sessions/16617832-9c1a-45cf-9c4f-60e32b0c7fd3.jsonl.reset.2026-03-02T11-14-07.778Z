{"type":"message","id":"1f65138c","parentId":"752fa4d5","timestamp":"2026-02-25T13:20:32.330Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"好的，LM Studio 中有 `qwen/qwen3.5-35b-a3b` 模型。我需要：\n1. 更新测试脚本，添加编程能力测试\n2. 分别测试 Qwen3.5-35B 和 GLM-5\n3. 生成对比报告\n\n让我创建一个专门针对编程能力的测试脚本。","thinkingSignature":"reasoning_content"},{"type":"text","text":"好的，LM Studio 有 `qwen/qwen3.5-35b-a3b`。让我创建一个编程能力对比测试："},{"type":"toolCall","id":"call_3ea6c8c9946a4f908831a912","name":"write","arguments":{"path":"/Users/ciss-ai/.openclaw/agents/pm/tools/llm-benchmark/test-coding.py","content":"#!/usr/bin/env python3\n\"\"\"\nLLM 编程能力对比测试\n测试两个模型的编程能力并生成对比报告\n使用方法: python3 test-coding.py\n\"\"\"\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nimport urllib.request\nimport urllib.error\nfrom datetime import datetime\nfrom pathlib import Path\n\n# 配置\nAPI_BASE = \"http://localhost:1234/v1\"\nOUTPUT_DIR = Path(__file__).parent / \"reports\"\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\nTIMESTAMP = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n\n# 要对比的模型\nMODELS = [\n    {\n        \"id\": \"qwen/qwen3.5-35b-a3b\",\n        \"name\": \"Qwen3.5-35B-A3B (LM Studio)\"\n    },\n    {\n        \"id\": \"zai/glm-5\",\n        \"name\": \"GLM-5 (智谱云端)\",\n        \"api_base\": \"https://open.bigmodel.cn/api/coding/paas/v4\",\n        \"api_key\": os.environ.get(\"ZAI_API_KEY\", \"\")\n    }\n]\n\n# 颜色\nRED = '\\033[0;31m'\nGREEN = '\\033[0;32m'\nYELLOW = '\\033[1;33m'\nCYAN = '\\033[0;36m'\nNC = '\\033[0m'\n\ndef test_completion(model: dict, prompt: str, max_tokens: int = 2048, temperature: float = 0.7) -> dict:\n    \"\"\"调用模型 API 并返回结果\"\"\"\n    api_base = model.get(\"api_base\", API_BASE)\n    api_key = model.get(\"api_key\", \"\")\n    \n    headers = {'Content-Type': 'application/json'}\n    if api_key:\n        headers['Authorization'] = f'Bearer {api_key}'\n    \n    data = json.dumps({\n        \"model\": model[\"id\"],\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n        \"max_tokens\": max_tokens,\n        \"temperature\": temperature,\n        \"stream\": False\n    }).encode('utf-8')\n    \n    req = urllib.request.Request(\n        f\"{api_base}/chat/completions\",\n        data=data,\n        headers=headers,\n        method='POST'\n    )\n    \n    start_time = time.time() * 1000\n    \n    try:\n        with urllib.request.urlopen(req, timeout=180) as response:\n            response_data = json.loads(response.read().decode('utf-8'))\n    except urllib.error.URLError as e:\n        return {\n            \"raw_content\": f\"API Error: {e}\",\n            \"content\": f\"API Error: {e}\",\n            \"duration_ms\": 0,\n            \"prompt_tokens\": 0,\n            \"completion_tokens\": 0,\n            \"tokens_per_sec\": 0,\n            \"error\": str(e)\n        }\n    except Exception as e:\n        return {\n            \"raw_content\": f\"Error: {e}\",\n            \"content\": f\"Error: {e}\",\n            \"duration_ms\": 0,\n            \"prompt_tokens\": 0,\n            \"completion_tokens\": 0,\n            \"tokens_per_sec\": 0,\n            \"error\": str(e)\n        }\n    \n    end_time = time.time() * 1000\n    duration_ms = int(end_time - start_time)\n    \n    raw_content = response_data.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"\")\n    usage = response_data.get(\"usage\", {})\n    prompt_tokens = usage.get(\"prompt_tokens\", 0)\n    completion_tokens = usage.get(\"completion_tokens\", 0)\n    \n    # 提取最终答案（过滤思考过程）\n    content = extract_answer(raw_content)\n    \n    # 计算速度\n    tokens_per_sec = round(completion_tokens / (duration_ms / 1000), 2) if duration_ms > 0 and completion_tokens > 0 else 0\n    \n    return {\n        \"raw_content\": raw_content,\n        \"content\": content,\n        \"duration_ms\": duration_ms,\n        \"prompt_tokens\": prompt_tokens,\n        \"completion_tokens\": completion_tokens,\n        \"tokens_per_sec\": tokens_per_sec\n    }\n\ndef extract_answer(content: str) -> str:\n    \"\"\"提取最终答案，过滤思考过程\"\"\"\n    # 尝试匹配 </think...> 后的内容\n    patterns = [\n        r'</think[^>]*>\\s*(.+)',\n        r'\\[/?think\\]\\s*(.+)',\n        r'<\\|/?end_thought\\|>\\s*(.+)',\n    ]\n    \n    for pattern in patterns:\n        match = re.search(pattern, content, re.DOTALL | re.IGNORECASE)\n        if match:\n            answer = match.group(1).strip()\n            if answer:\n                return answer\n    \n    return content\n\n# 编程测试用例\nCODING_TESTS = [\n    {\n        \"name\": \"快速排序\",\n        \"prompt\": \"用 Python 实现快速排序算法。要求：\\n1. 代码简洁高效\\n2. 添加注释\\n3. 包含测试用例\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"def quicksort\", \"def partition\", \"pivot\", \"recursive\"]\n    },\n    {\n        \"name\": \"二分查找\",\n        \"prompt\": \"用 Python 实现二分查找算法。要求：\\n1. 处理找不到的情况\\n2. 添加类型注解\\n3. 包含测试用例\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"def binary_search\", \"mid\", \"left\", \"right\", \"-1\"]\n    },\n    {\n        \"name\": \"LRU缓存\",\n        \"prompt\": \"用 Python 实现一个 LRU (Least Recently Used) 缓存。要求：\\n1. 支持get和put操作\\n2. O(1)时间复杂度\\n3. 指定容量\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"class LRU\", \"OrderedDict\", \"def get\", \"def put\", \"capacity\"]\n    },\n    {\n        \"name\": \"生产者消费者\",\n        \"prompt\": \"用 Python 实现生产者-消费者模式。要求：\\n1. 使用多线程\\n2. 使用Queue\\n3. 添加终止条件\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"threading\", \"Queue\", \"producer\", \"consumer\", \"start\"]\n    },\n    {\n        \"name\": \"JSON解析器\",\n        \"prompt\": \"用 Python 实现一个简单的 JSON 解析器，支持：\\n1. 对象 {}\\n2. 数组 []\\n3. 字符串、数字、布尔值、null\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"def parse\", \"json\", \"string\", \"number\", \"object\", \"array\"]\n    },\n    {\n        \"name\": \"正则匹配\",\n        \"prompt\": \"用 Python 实现一个函数，验证邮箱地址是否合法。要求：\\n1. 使用正则表达式\\n2. 返回布尔值\\n3. 处理边界情况\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"import re\", \"def\", \"@\", \"match\", \"return\"]\n    },\n    {\n        \"name\": \"算法复杂度\",\n        \"prompt\": \"解释以下代码的时间复杂度和空间复杂度，并说明原因：\\n\\ndef mystery(n):\\n    result = []\\n    for i in range(n):\\n        for j in range(n):\\n            result.append(i * j)\\n    return result\",\n        \"check_code\": False,\n        \"expected_patterns\": [\"O(n²)\", \"O(n^2)\", \"O(n*n)\", \"平方\", \"quadratic\"]\n    },\n    {\n        \"name\": \"Bug修复\",\n        \"prompt\": \"找出以下 Python 代码的 bug 并修复：\\n\\ndef calculate_average(numbers):\\n    total = 0\\n    for num in numbers:\\n        total += num\\n    return total / len(numbers)\\n\\nprint(calculate_average([]))\",\n        \"check_code\": False,\n        \"expected_patterns\": [\"空\", \"empty\", \"ZeroDivision\", \"len\", \"if not\", \"[]\"]\n    },\n    {\n        \"name\": \"SQL编写\",\n        \"prompt\": \"写一个 SQL 查询：有一个订单表 orders(id, user_id, amount, created_at)，找出每个用户在2024年的订单总额，按总额降序排列，只显示前10名。\",\n        \"check_code\": False,\n        \"expected_patterns\": [\"SELECT\", \"FROM\", \"GROUP BY\", \"ORDER BY\", \"SUM\", \"LIMIT\", \"2024\"]\n    },\n    {\n        \"name\": \"API设计\",\n        \"prompt\": \"用 Python Flask 设计一个 RESTful API，包含：\\n1. GET /users - 获取用户列表\\n2. POST /users - 创建用户\\n3. GET /users/<id> - 获取单个用户\\n4. PUT /users/<id> - 更新用户\\n5. DELETE /users/<id> - 删除用户\",\n        \"check_code\": True,\n        \"expected_patterns\": [\"flask\", \"Flask\", \"@app.route\", \"GET\", \"POST\", \"DELETE\", \"jsonify\"]\n    }\n]\n\ndef evaluate_code(content: str, expected_patterns: list) -> tuple:\n    \"\"\"评估代码质量\"\"\"\n    found = []\n    content_lower = content.lower()\n    \n    for pattern in expected_patterns:\n        if pattern.lower() in content_lower:\n            found.append(pattern)\n    \n    score = len(found) / len(expected_patterns) * 100 if expected_patterns else 0\n    \n    if score >= 80:\n        return \"PASS\", f\"{score:.0f}%\", f\"包含 {len(found)}/{len(expected_patterns)} 个关键元素\"\n    elif score >= 50:\n        return \"PARTIAL\", f\"{score:.0f}%\", f\"包含 {len(found)}/{len(expected_patterns)} 个关键元素\"\n    else:\n        return \"FAIL\", f\"{score:.0f}%\", f\"仅包含 {len(found)}/{len(expected_patterns)} 个关键元素\"\n\ndef run_tests():\n    \"\"\"运行所有测试\"\"\"\n    results = {model[\"id\"]: [] for model in MODELS}\n    \n    for model in MODELS:\n        print(f\"\\n{'='*60}\")\n        print(f\"{CYAN}Testing: {model['name']}{NC}\")\n        print(f\"{'='*60}\")\n        \n        for i, test in enumerate(CODING_TESTS, 1):\n            print(f\"\\n{YELLOW}[{i}/{len(CODING_TESTS)}] {test['name']}{NC}\")\n            \n            result = test_completion(model, test[\"prompt\"])\n            result[\"test\"] = test\n            \n            # 评估\n            eval_result, eval_score, eval_detail = evaluate_code(\n                result[\"content\"], \n                test.get(\"expected_patterns\", [])\n            )\n            result[\"eval\"] = eval_result\n            result[\"eval_score\"] = eval_score\n            result[\"eval_detail\"] = eval_detail\n            \n            # 显示结果\n            if eval_result == \"PASS\":\n                print(f\"  {GREEN}✓ {eval_result}{NC} ({eval_score})\")\n            elif eval_result == \"PARTIAL\":\n                print(f\"  {YELLOW}◐ {eval_result}{NC} ({eval_score})\")\n            else:\n                print(f\"  {RED}✗ {eval_result}{NC} ({eval_score})\")\n            \n            if result.get(\"error\"):\n                print(f\"  {RED}Error: {result['error']}{NC}\")\n            else:\n                print(f\"  Tokens: {result['completion_tokens']} | Speed: {result['tokens_per_sec']} t/s\")\n            \n            # 显示代码预览\n            preview = result[\"content\"][:150].replace('\\n', ' ')\n            if len(result[\"content\"]) > 150:\n                preview += \"...\"\n            print(f\"  Preview: {preview}\")\n            \n            results[model[\"id\"]].append(result)\n    \n    return results\n\ndef generate_report(results):\n    \"\"\"生成对比报告\"\"\"\n    print(f\"\\n{GREEN}Generating comparison report...{NC}\")\n    \n    report_file = OUTPUT_DIR / f\"coding-comparison_{TIMESTAMP}.md\"\n    \n    # 统计数据\n    model_stats = {}\n    for model in MODELS:\n        model_id = model[\"id\"]\n        model_results = results[model_id]\n        \n        pass_count = sum(1 for r in model_results if r.get(\"eval\") == \"PASS\")\n        partial_count = sum(1 for r in model_results if r.get(\"eval\") == \"PARTIAL\")\n        fail_count = sum(1 for r in model_results if r.get(\"eval\") == \"FAIL\")\n        \n        valid_speeds = [r[\"tokens_per_sec\"] for r in model_results if r[\"tokens_per_sec\"] > 0]\n        avg_speed = round(sum(valid_speeds) / len(valid_speeds), 2) if valid_speeds else 0\n        \n        total_tokens = sum(r[\"completion_tokens\"] for r in model_results)\n        \n        model_stats[model_id] = {\n            \"name\": model[\"name\"],\n            \"pass\": pass_count,\n            \"partial\": partial_count,\n            \"fail\": fail_count,\n            \"total\": len(model_results),\n            \"avg_speed\": avg_speed,\n            \"total_tokens\": total_tokens\n        }\n    \n    # 生成报告\n    report = f\"\"\"# 编程能力对比测试报告\n\n## 测试信息\n\n| 项目 | 值 |\n|------|-----|\n| 测试时间 | {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} |\n| 测试用例数 | {len(CODING_TESTS)} |\n| 测试类型 | 算法实现、Bug修复、SQL、API设计 |\n\n---\n\n## 总体对比\n\n| 模型 | 通过 | 部分通过 | 失败 | 平均速度 | 总输出 |\n|------|------|----------|------|----------|--------|\n\"\"\"\n    \n    for model_id, stats in model_stats.items():\n        report += f\"| {stats['name']} | ✓{stats['pass']} | ◐{stats['partial']} | ✗{stats['fail']} | {stats['avg_speed']} t/s | {stats['total_tokens']} tokens |\\n\"\n    \n    report += \"\\n---\\n\\n## 详细对比\\n\\n\"\n    \n    for test in CODING_TESTS:\n        report += f\"### {test['name']}\\n\\n\"\n        report += f\"**提示词**: {test['prompt'][:100]}...\\n\\n\"\n        report += \"| 模型 | 结果 | 速度 | 代码预览 |\\n\"\n        report += \"|------|------|------|----------|\\n\"\n        \n        for model in MODELS:\n            model_id = model[\"id\"]\n            for r in results[model_id]:\n                if r[\"test\"][\"name\"] == test[\"name\"]:\n                    eval_icon = \"✓\" if r[\"eval\"] == \"PASS\" else \"◐\" if r[\"eval\"] == \"PARTIAL\" else \"✗\"\n                    preview = r[\"content\"][:80].replace('\\n', ' ').replace('|', '\\\\|')\n                    if len(r[\"content\"]) > 80:\n                        preview += \"...\"\n                    report += f\"| {model['name']} | {eval_icon} {r['eval_score']} | {r['tokens_per_sec']} t/s | {preview} |\\n\"\n                    break\n        \n        report += \"\\n\"\n    \n    # 完整输出\n    report += \"---\\n\\n## 完整输出\\n\\n\"\n    \n    for test in CODING_TESTS:\n        report += f\"### {test['name']}\\n\\n\"\n        \n        for model in MODELS:\n            model_id = model[\"id\"]\n            for r in results[model_id]:\n                if r[\"test\"][\"name\"] == test[\"name\"]:\n                    content = r[\"content\"]\n                    if len(content) > 3000:\n                        content = content[:3000] + \"\\n\\n... (truncated)\"\n                    \n                    report += f\"#### {model['name']}\\n\\n\"\n                    report += f\"```\\n{content}\\n```\\n\\n\"\n                    report += f\"*评估: {r['eval']} ({r['eval_score']}) - {r['eval_detail']}*\\n\\n\"\n                    report += \"---\\n\\n\"\n                    break\n    \n    # 人工评分区\n    report += \"\"\"## 人工评分区\n\n请根据代码质量、正确性、可读性进行评分：\n\n| 测试项 | Qwen3.5 | GLM-5 | 备注 |\n|--------|---------|-------|------|\n| 快速排序 | /10 | /10 | |\n| 二分查找 | /10 | /10 | |\n| LRU缓存 | /10 | /10 | |\n| 生产者消费者 | /10 | /10 | |\n| JSON解析器 | /10 | /10 | |\n| 正则匹配 | /10 | /10 | |\n| 算法复杂度 | /10 | /10 | |\n| Bug修复 | /10 | /10 | |\n| SQL编写 | /10 | /10 | |\n| API设计 | /10 | /10 | |\n| **总分** | **/100** | **/100** | |\n\n---\n\n*Generated by LLM Coding Benchmark*\n\"\"\"\n    \n    with open(report_file, \"w\", encoding=\"utf-8\") as f:\n        f.write(report)\n    \n    return report_file, model_stats\n\ndef main():\n    print(\"=\" * 60)\n    print(\"LLM 编程能力对比测试\")\n    print(\"=\" * 60)\n    print(f\"Models: {[m['name'] for m in MODELS]}\")\n    print(f\"Tests: {len(CODING_TESTS)} 编程任务\")\n    \n    results = run_tests()\n    report_file, stats = generate_report(results)\n    \n    print(\"\\n\" + \"=\" * 60)\n    print(f\"{GREEN}Test Complete!{NC}\")\n    print(\"=\" * 60)\n    print(f\"\\nReport: {report_file}\")\n    print(\"\\nSummary:\")\n    \n    for model_id, s in stats.items():\n        print(f\"  {s['name']}: ✓{s['pass']} ◐{s['partial']} ✗{s['fail']} | {s['avg_speed']} t/s\")\n\nif __name__ == \"__main__\":\n    main()\n"}}],"api":"openai-completions","provider":"zai","model":"glm-5","usage":{"input":219,"output":4075,"cacheRead":51200,"cacheWrite":0,"totalTokens":55494,"cost":{"input":0.00021899999999999998,"output":0.013040000000000001,"cacheRead":0.01024,"cacheWrite":0,"total":0.023499000000000003}},"stopReason":"toolUse","timestamp":1772025479613}}
