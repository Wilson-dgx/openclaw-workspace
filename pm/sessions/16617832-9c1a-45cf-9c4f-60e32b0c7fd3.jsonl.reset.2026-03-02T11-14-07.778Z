{"type":"message","id":"7f4b5c74","parentId":"6740f08b","timestamp":"2026-02-24T23:04:03.898Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"仍然有问题。思考内容没有被正确过滤。我需要改进过滤逻辑。问题是 sed 在处理多行内容时不够强大。让我用 Python 来处理过滤。","thinkingSignature":"reasoning_content"},{"type":"text","text":"过滤逻辑还需要改进。让我用 Python 来正确处理多行内容："},{"type":"toolCall","id":"call_7e20532334164b85a31e99a9","name":"write","arguments":{"content":"#!/usr/bin/env python3\n\"\"\"\nLLM Benchmark Test Script\n本地大模型能力评估测试\n使用方法: python3 test-llm.py [model_name] [api_base]\n\"\"\"\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nimport requests\nfrom datetime import datetime\nfrom pathlib import Path\n\n# 配置\nMODEL_NAME = sys.argv[1] if len(sys.argv) > 1 else \"minimax-m2p5-mlx\"\nAPI_BASE = sys.argv[2] if len(sys.argv) > 2 else \"http://localhost:1234/v1\"\nOUTPUT_DIR = Path(__file__).parent / \"reports\"\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\nTIMESTAMP = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\nREPORT_FILE = OUTPUT_DIR / f\"{MODEL_NAME.replace('/', '-')}_{TIMESTAMP}.md\"\n\n# 颜色\nRED = '\\033[0;31m'\nGREEN = '\\033[0;32m'\nYELLOW = '\\033[1;33m'\nNC = '\\033[0m'\n\ndef test_completion(prompt: str, max_tokens: int = 512, temperature: float = 0.7) -> dict:\n    \"\"\"调用模型 API 并返回结果\"\"\"\n    start_time = time.time() * 1000\n    \n    response = requests.post(\n        f\"{API_BASE}/chat/completions\",\n        json={\n            \"model\": MODEL_NAME,\n            \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n            \"max_tokens\": max_tokens,\n            \"temperature\": temperature,\n            \"stream\": False\n        },\n        timeout=120\n    )\n    \n    end_time = time.time() * 1000\n    duration_ms = int(end_time - start_time)\n    \n    data = response.json()\n    raw_content = data.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"\")\n    usage = data.get(\"usage\", {})\n    prompt_tokens = usage.get(\"prompt_tokens\", 0)\n    completion_tokens = usage.get(\"completion_tokens\", 0)\n    \n    # 提取最终答案（过滤思考过程）\n    # 思考型模型格式: <think...>思考内容</think...>最终答案\n    # 使用正则匹配并移除思考标签及其内容\n    content = extract_answer(raw_content)\n    \n    # 计算速度\n    tokens_per_sec = round(completion_tokens / (duration_ms / 1000), 2) if duration_ms > 0 and completion_tokens > 0 else 0\n    \n    return {\n        \"raw_content\": raw_content,\n        \"content\": content,\n        \"duration_ms\": duration_ms,\n        \"prompt_tokens\": prompt_tokens,\n        \"completion_tokens\": completion_tokens,\n        \"tokens_per_sec\": tokens_per_sec\n    }\n\ndef extract_answer(content: str) -> str:\n    \"\"\"提取最终答案，过滤思考过程\"\"\"\n    # 尝试匹配 </think...> 后的内容（支持各种变体）\n    patterns = [\n        r'</think[^>]*>\\s*(.+)',  # </think...> 后的内容\n        r'\\[/?think\\]\\s*(.+)',     # [/think] 或 [think] 后的内容\n        r'<\\|/?end_thought\\|>\\s*(.+)',  # <|end_thought|> 后的内容\n    ]\n    \n    for pattern in patterns:\n        match = re.search(pattern, content, re.DOTALL | re.IGNORECASE)\n        if match:\n            answer = match.group(1).strip()\n            if answer:\n                return answer\n    \n    # 如果没有找到思考标签，返回原始内容\n    return content\n\ndef evaluate_math(actual: str, expected: str) -> tuple:\n    \"\"\"评估数学答案\"\"\"\n    # 提取数字\n    numbers = re.findall(r'\\d+', actual)\n    expected_nums = re.findall(r'\\d+', expected)\n    \n    if set(numbers) == set(expected_nums):\n        return \"PASS\", \"数字匹配\"\n    \n    # 检查是否包含正确答案\n    for exp_num in expected_nums:\n        if exp_num in numbers:\n            return \"PASS\", f\"包含正确数字 {exp_num}\"\n    \n    return \"FAIL\", f\"期望 {expected_nums}, 得到 {numbers[:5]}\"\n\ndef evaluate_logic(actual: str, expected: str) -> tuple:\n    \"\"\"评估逻辑答案\"\"\"\n    actual_lower = actual.lower()\n    if expected.lower() in actual_lower:\n        return \"PASS\", f\"包含 '{expected}'\"\n    return \"FAIL\", f\"期望包含 '{expected}'\"\n\ndef evaluate_contains(actual: str, keywords: list) -> tuple:\n    \"\"\"检查是否包含关键词\"\"\"\n    actual_lower = actual.lower()\n    found = [kw for kw in keywords if kw.lower() in actual_lower]\n    if found:\n        return \"PASS\", f\"包含关键词: {found}\"\n    return \"FAIL\", f\"未找到关键词: {keywords}\"\n\ndef evaluate_code(actual: str) -> tuple:\n    \"\"\"评估代码生成\"\"\"\n    code_patterns = [\n        r'def\\s+\\w+\\s*\\(',  # 函数定义\n        r'for\\s+\\w+\\s+in',  # for 循环\n        r'if\\s+.*:',        # if 语句\n        r'return\\s+',       # return 语句\n        r'import\\s+\\w+',    # import\n    ]\n    \n    found = []\n    for pattern in code_patterns:\n        if re.search(pattern, actual):\n            found.append(pattern[:20])\n    \n    if len(found) >= 2:\n        return \"PASS\", f\"包含代码结构: {len(found)}处\"\n    return \"FAIL\", f\"代码结构不足: {len(found)}处\"\n\ndef evaluate_length(actual: str, max_chars: int) -> tuple:\n    \"\"\"评估长度\"\"\"\n    length = len(actual)\n    if length <= max_chars:\n        return \"PASS\", f\"长度 {length} <= {max_chars}\"\n    return \"FAIL\", f\"长度 {length} > {max_chars}\"\n\ndef evaluate_lines(actual: str, min_lines: int, no_numbers: bool = True) -> tuple:\n    \"\"\"评估多行输出\"\"\"\n    lines = [l.strip() for l in actual.strip().split('\\n') if l.strip()]\n    \n    if len(lines) < min_lines:\n        return \"FAIL\", f\"行数 {len(lines)} < {min_lines}\"\n    \n    if no_numbers:\n        # 检查是否有数字序号开头\n        for line in lines[:5]:\n            if re.match(r'^\\d+[.、)\\]]', line):\n                return \"FAIL\", \"包含数字序号\"\n    \n    return \"PASS\", f\"{len(lines)}行，格式正确\"\n\n# 测试用例\nTESTS = [\n    {\n        \"name\": \"Speed Test\",\n        \"category\": \"speed\",\n        \"prompt\": \"请重复以下内容：人工智能正在改变世界，我们需要认真思考它对人类社会的影响。请重复这句话10遍。\",\n        \"max_tokens\": 512,\n        \"temp\": 0.1\n    },\n    {\n        \"name\": \"Math Reasoning\",\n        \"category\": \"math\",\n        \"prompt\": \"一个农场有鸡和兔子共35个头，94只脚。请问有多少只鸡和多少只兔子？请只回答数字，格式：鸡=X, 兔=Y\",\n        \"max_tokens\": 512,\n        \"temp\": 0.3,\n        \"expected\": \"23 12\"\n    },\n    {\n        \"name\": \"Logic Reasoning\",\n        \"category\": \"logic\",\n        \"prompt\": \"所有猫都是动物。所有动物都需要水。因此，所有猫都需要水。这个推理是否正确？请只回答：正确或不正确\",\n        \"max_tokens\": 256,\n        \"temp\": 0.3,\n        \"expected\": \"正确\"\n    },\n    {\n        \"name\": \"Code Generation\",\n        \"category\": \"code\",\n        \"prompt\": \"用Python写一个快速排序算法。只需要代码，不需要解释。\",\n        \"max_tokens\": 1024,\n        \"temp\": 0.7\n    },\n    {\n        \"name\": \"Chinese Understanding\",\n        \"category\": \"chinese\",\n        \"prompt\": \"请解释成语「画蛇添足」的含义，并用它造一个句子。\",\n        \"max_tokens\": 512,\n        \"temp\": 0.7,\n        \"keywords\": [\"多余\", \"多此一举\", \"不必要\"]\n    },\n    {\n        \"name\": \"English Understanding\",\n        \"category\": \"english\",\n        \"prompt\": \"Explain the difference between 'affect' and 'effect' with examples.\",\n        \"max_tokens\": 512,\n        \"temp\": 0.7,\n        \"keywords\": [\"verb\", \"noun\", \"action\", \"result\"]\n    },\n    {\n        \"name\": \"Knowledge Q&A\",\n        \"category\": \"knowledge\",\n        \"prompt\": \"请简述光合作用的基本过程。\",\n        \"max_tokens\": 512,\n        \"temp\": 0.7,\n        \"keywords\": [\"叶绿体\", \"二氧化碳\", \"氧气\", \"光能\", \"葡萄糖\"]\n    },\n    {\n        \"name\": \"Summarization\",\n        \"category\": \"summary\",\n        \"prompt\": \"请将以下文字总结为一句话（不超过50字）：\\n\\n2024年，人工智能领域取得了重大突破。OpenAI发布了GPT-4o，谷歌推出了Gemini 1.5 Pro，Anthropic发布了Claude 3。这些模型在推理能力、多模态理解、长上下文处理等方面都有显著提升。同时，开源社区也在快速发展，Meta发布了Llama 3，阿里发布了Qwen系列模型。中国的AI产业也在快速追赶，智谱AI发布了GLM-4，在多项评测中表现出色。这一年被认为是AI应用的爆发之年，各行各业都在积极探索AI的落地应用。\",\n        \"max_tokens\": 256,\n        \"temp\": 0.5,\n        \"max_chars\": 100\n    },\n    {\n        \"name\": \"Creative Writing\",\n        \"category\": \"creative\",\n        \"prompt\": \"请写一个关于AI与人类友谊的短篇故事开头（100字以内）。\",\n        \"max_tokens\": 512,\n        \"temp\": 0.9\n    },\n    {\n        \"name\": \"Instruction Following\",\n        \"category\": \"instruction\",\n        \"prompt\": \"请列出5种水果的名称。要求：1.每行只写一个 2.按字母顺序排列 3.不要加序号 4.不要加任何解释\",\n        \"max_tokens\": 256,\n        \"temp\": 0.3,\n        \"min_lines\": 5\n    }\n]\n\ndef run_tests():\n    \"\"\"运行所有测试\"\"\"\n    print(\"=\" * 50)\n    print(\"LLM Benchmark Test\")\n    print(\"=\" * 50)\n    print(f\"Model: {MODEL_NAME}\")\n    print(f\"API: {API_BASE}\")\n    print(f\"Report: {REPORT_FILE}\")\n    print(\"=\" * 50)\n    print()\n    \n    results = []\n    \n    for i, test in enumerate(TESTS, 1):\n        print(f\"{YELLOW}[{i}/{len(TESTS)}] {test['name']}{NC}\")\n        \n        try:\n            result = test_completion(\n                prompt=test[\"prompt\"],\n                max_tokens=test.get(\"max_tokens\", 512),\n                temperature=test.get(\"temp\", 0.7)\n            )\n            \n            # 评估\n            eval_result = \"MANUAL\"\n            eval_detail = \"\"\n            \n            if test[\"category\"] == \"math\":\n                eval_result, eval_detail = evaluate_math(result[\"content\"], test.get(\"expected\", \"\"))\n            elif test[\"category\"] == \"logic\":\n                eval_result, eval_detail = evaluate_logic(result[\"content\"], test.get(\"expected\", \"\"))\n            elif test[\"category\"] in [\"chinese\", \"english\", \"knowledge\"]:\n                eval_result, eval_detail = evaluate_contains(result[\"content\"], test.get(\"keywords\", []))\n            elif test[\"category\"] == \"code\":\n                eval_result, eval_detail = evaluate_code(result[\"content\"])\n            elif test[\"category\"] == \"summary\":\n                eval_result, eval_detail = evaluate_length(result[\"content\"], test.get(\"max_chars\", 100))\n            elif test[\"category\"] == \"instruction\":\n                eval_result, eval_detail = evaluate_lines(result[\"content\"], test.get(\"min_lines\", 5))\n            \n            result[\"eval\"] = eval_result\n            result[\"eval_detail\"] = eval_detail\n            result[\"test\"] = test\n            \n            # 显示结果\n            if eval_result == \"PASS\":\n                print(f\"  {GREEN}✓ {eval_result}{NC}: {eval_detail}\")\n            elif eval_result == \"FAIL\":\n                print(f\"  {RED}✗ {eval_result}{NC}: {eval_detail}\")\n            else:\n                print(f\"  {YELLOW}○ {eval_result}{NC}\")\n            \n            print(f\"  Tokens: {result['completion_tokens']} in {result['duration_ms']}ms ({result['tokens_per_sec']} t/s)\")\n            \n            # 显示答案预览\n            preview = result[\"content\"][:100].replace('\\n', ' ')\n            if len(result[\"content\"]) > 100:\n                preview += \"...\"\n            print(f\"  Answer: {preview}\")\n            \n        except Exception as e:\n            print(f\"  {RED}ERROR: {e}{NC}\")\n            result = {\n                \"content\": f\"ERROR: {e}\",\n                \"eval\": \"ERROR\",\n                \"eval_detail\": str(e),\n                \"completion_tokens\": 0,\n                \"tokens_per_sec\": 0,\n                \"test\": test\n            }\n        \n        results.append(result)\n        print()\n    \n    return results\n\ndef generate_report(results):\n    \"\"\"生成测试报告\"\"\"\n    print(f\"{GREEN}Generating report...{NC}\")\n    \n    # 计算统计数据\n    valid_speeds = [r[\"tokens_per_sec\"] for r in results if r[\"tokens_per_sec\"] > 0]\n    avg_speed = round(sum(valid_speeds) / len(valid_speeds), 2) if valid_speeds else 0\n    \n    pass_count = sum(1 for r in results if r.get(\"eval\") == \"PASS\")\n    fail_count = sum(1 for r in results if r.get(\"eval\") == \"FAIL\")\n    manual_count = sum(1 for r in results if r.get(\"eval\") in [\"MANUAL\", \"ERROR\"])\n    auto_total = pass_count + fail_count\n    \n    # 生成 Markdown 报告\n    report = f\"\"\"# LLM Benchmark Report\n\n## 测试信息\n\n| 项目 | 值 |\n|------|-----|\n| 模型名称 | {MODEL_NAME} |\n| API地址 | {API_BASE} |\n| 测试时间 | {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} |\n| 平均速度 | {avg_speed} tokens/sec |\n| 自动测试结果 | ✓{pass_count} ✗{fail_count} ({auto_total}项自动评估) |\n\n---\n\n## 性能指标\n\n| 测试项 | Tokens | 速度 (t/s) | 评估 | 详情 |\n|--------|--------|-----------|------|------|\n\"\"\"\n    \n    for r in results:\n        test_name = r[\"test\"][\"name\"]\n        tokens = r[\"completion_tokens\"]\n        speed = r[\"tokens_per_sec\"]\n        eval_result = r.get(\"eval\", \"N/A\")\n        eval_detail = r.get(\"eval_detail\", \"\")\n        \n        eval_icon = \"✓\" if eval_result == \"PASS\" else \"✗\" if eval_result == \"FAIL\" else \"○\"\n        report += f\"| {test_name} | {tokens} | {speed} | {eval_icon} {eval_result} | {eval_detail[:30]} |\\n\"\n    \n    report += \"\\n---\\n\\n## 详细输出\\n\\n\"\n    \n    for r in results:\n        test_name = r[\"test\"][\"name\"]\n        prompt = r[\"test\"][\"prompt\"]\n        answer = r[\"content\"]\n        eval_result = r.get(\"eval\", \"N/A\")\n        eval_detail = r.get(\"eval_detail\", \"\")\n        \n        # 截断过长的内容\n        if len(answer) > 2000:\n            answer = answer[:2000] + \"\\n... (truncated)\"\n        \n        report += f\"\"\"### {test_name}\n\n**提示词**:\n```\n{prompt[:500]}{'...' if len(prompt) > 500 else ''}\n```\n\n**回答**:\n```\n{answer}\n```\n\n**评估**: {eval_result} - {eval_detail}\n\n---\n\n\"\"\"\n    \n    # 添加人工评分区\n    report += \"\"\"## 人工评分区\n\n| 能力维度 | 评分 (1-10) | 备注 |\n|----------|-------------|------|\n| 数学推理 | /10 | |\n| 逻辑推理 | /10 | |\n| 代码质量 | /10 | |\n| 中文表达 | /10 | |\n| 英文表达 | /10 | |\n| 知识准确性 | /10 | |\n| 摘要质量 | /10 | |\n| 创意程度 | /10 | |\n| 指令遵循 | /10 | |\n| **总分** | **/90** | |\n\n---\n\n*Generated by LLM Benchmark Test*\n\"\"\"\n    \n    # 写入文件\n    with open(REPORT_FILE, \"w\", encoding=\"utf-8\") as f:\n        f.write(report)\n    \n    return {\n        \"avg_speed\": avg_speed,\n        \"pass_count\": pass_count,\n        \"fail_count\": fail_count,\n        \"manual_count\": manual_count\n    }\n\ndef main():\n    results = run_tests()\n    stats = generate_report(results)\n    \n    print()\n    print(f\"{GREEN}{'=' * 50}{NC}\")\n    print(f\"{GREEN}Test Complete!{NC}\")\n    print(f\"{GREEN}{'=' * 50}{NC}\")\n    print()\n    print(f\"Report saved to: {REPORT_FILE}\")\n    print()\n    print(\"Summary:\")\n    print(f\"  - Model: {MODEL_NAME}\")\n    print(f\"  - Avg Speed: {stats['avg_speed']} tokens/sec\")\n    print(f\"  - Results: ✓{stats['pass_count']} ✗{stats['fail_count']} ○{stats['manual_count']}\")\n    print()\n\nif __name__ == \"__main__\":\n    main()\n","path":"/Users/ciss-ai/.openclaw/agents/pm/tools/llm-benchmark/test-llm.py"}}],"api":"openai-completions","provider":"zai","model":"glm-5","usage":{"input":1036,"output":3984,"cacheRead":31040,"cacheWrite":0,"totalTokens":36060,"cost":{"input":0.001036,"output":0.012748800000000001,"cacheRead":0.006208000000000001,"cacheWrite":0,"total":0.0199928}},"stopReason":"toolUse","timestamp":1771974120154}}
