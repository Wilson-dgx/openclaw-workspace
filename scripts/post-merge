#!/bin/bash
# Git 同步后钩子 - 自动修复配置路径
# 安装: cp scripts/post-merge .git/hooks/ && chmod +x .git/hooks/post-merge

set -e

WORKSPACE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
OPENCLAW_CONFIG="$HOME/.openclaw/openclaw.json"

echo "🔄 Git 同步后处理..."

# 颜色输出
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

# 1. 检查配置文件是否存在
if [ ! -f "$OPENCLAW_CONFIG" ]; then
    warn "OpenClaw 配置不存在，跳过"
    exit 0
fi

# 2. 检查配置是否需要更新
if grep -q '/Users/ciss-ai' "$OPENCLAW_CONFIG" 2>/dev/null; then
    log "检测到旧路径，自动修复配置..."
    
    # 备份
    cp "$OPENCLAW_CONFIG" "$OPENCLAW_CONFIG.backup.$(date +%Y%m%d%H%M%S)"
    
    # 替换路径
    sed -i '' "s|/Users/ciss-ai|$HOME|g" "$OPENCLAW_CONFIG"
    
    log "✅ 配置已修复"
fi

# 3. 确保本地专属文件存在
if [ ! -f "$WORKSPACE_DIR/HEARTBEAT.md" ]; then
    touch "$WORKSPACE_DIR/HEARTBEAT.md"
    log "创建 HEARTBEAT.md"
fi

if [ ! -f "$WORKSPACE_DIR/TOOLS.md" ]; then
    touch "$WORKSPACE_DIR/TOOLS.md"
    log "创建 TOOLS.md"
fi

# 4. 更新记忆索引
if [ -f "$WORKSPACE_DIR/scripts/memory-toolkit.sh" ]; then
    log "更新记忆索引..."
    "$WORKSPACE_DIR/scripts/memory-toolkit.sh" index >/dev/null 2>&1 || true
fi

log "✅ 同步后处理完成"
